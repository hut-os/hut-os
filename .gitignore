# Build outputs
/build/
/dist/*.iso
/initramfs.cpio.gz
/hutos.img
/hutos.iso
/hutos-x86_64.iso
*.cpio
*.cpio.gz
*.iso
*.img

# Bundled host installer binaries (regenerated by scripts/bundle-installer-tools.sh)
/rootfs/usr/lib/hutos-install/host/
/rootfs/usr/lib/grub/
/rootfs/boot/bzImage
/rootfs/boot/vmlinuz

# Full upstream Linux tree lives elsewhere — only configs/ is tracked here
/kernel/

# Editor / OS junk
*~
*.swp
*.swo
.DS_Store
.vscode/
.idea/

# Temporary / local notes
.PROJECT_COMPLETE.md
*.log
/tmp/

# Zsh completion dump
**/.zcompdump*
**/root/.zsh_history
**/home/*/.zsh_history
