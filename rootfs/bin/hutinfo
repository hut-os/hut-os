#!/bin/busybox sh
# hutinfo — HUTOS System Information Display
# Show detailed HUTOS system information

# Source common library
. /lib/hutos-common.sh 2>/dev/null || {
	echo "Error: HUTOS common library not found"
	exit 1
}

VERSION="1.0.0"

show_usage() {
	cat <<-EOF
		hutinfo — HUTOS System Information Display
		
		Usage: hutinfo [options]
		
		Options:
		  --help, -h     Show this help message
		  --version, -v  Show version information
		
		Description:
		  Displays comprehensive HUTOS system information including:
		  - Operating system details
		  - Kernel version and architecture
		  - CPU information
		  - Memory statistics
		  - Uptime and load
		  - Scheduler information
		  - Hostname and init system
		  - Build information
	EOF
}

# Parse arguments
case "$1" in
	--help|-h)
		show_usage
		exit 0
		;;
	--version|-v)
		echo "hutinfo version $VERSION"
		exit 0
		;;
	"")
		# Continue with normal operation
		;;
	*)
		echo "Error: Unknown option '$1'"
		show_usage
		exit 1
		;;
esac

print_header "HUTOS System Information"

# Operating System
print_section "Operating System"
print_kv "Name" "$HUTOS_NAME"
print_kv "Version" "$HUTOS_VERSION"
print_kv "Hostname" "$(get_hostname)"

# Kernel
print_section "Kernel"
print_kv "Version" "$(get_kernel_version)"
print_kv "Architecture" "$(get_architecture)"

if [ -f /proc/version ]; then
	KERNEL_FULL=$(cat /proc/version | cut -d' ' -f1-3)
	print_kv "Full Version" "$KERNEL_FULL"
fi

# CPU
print_section "CPU"
CPU_MODEL=$(get_cpu_info)
print_kv "Model" "$CPU_MODEL"
print_kv "Cores" "$(get_cpu_count)"

if [ -f /proc/cpuinfo ]; then
	CPU_MHZ=$(awk '/cpu MHz/ {printf "%.0f MHz", $4; exit}' /proc/cpuinfo 2>/dev/null)
	[ -n "$CPU_MHZ" ] && print_kv "Frequency" "$CPU_MHZ"
	
	CPU_CACHE=$(awk '/cache size/ {print $4 " " $5; exit}' /proc/cpuinfo 2>/dev/null)
	[ -n "$CPU_CACHE" ] && print_kv "Cache" "$CPU_CACHE"
fi

# Memory
print_section "Memory"
print_kv "Total" "$(get_memory_total)"
print_kv "Free" "$(get_memory_free)"

if [ -f /proc/meminfo ]; then
	MEM_USED=$(awk '/MemTotal:/ {total=$2} /MemAvailable:/ {avail=$2} END {printf "%.1f MiB", (total-avail)/1024}' /proc/meminfo)
	print_kv "Used" "$MEM_USED"
	
	SWAP_TOTAL=$(awk '/SwapTotal:/ {printf "%.1f MiB", $2/1024}' /proc/meminfo)
	if [ "$SWAP_TOTAL" != "0.0 MiB" ]; then
		print_kv "Swap Total" "$SWAP_TOTAL"
		SWAP_FREE=$(awk '/SwapFree:/ {printf "%.1f MiB", $2/1024}' /proc/meminfo)
		print_kv "Swap Free" "$SWAP_FREE"
	fi
fi

# Uptime and Load
print_section "Uptime and Load"
print_kv "Uptime" "$(get_uptime)"
print_kv "Load Average" "$(get_load_average)"

if [ -f /proc/loadavg ]; then
	RUNNING_TASKS=$(awk '{print $4}' /proc/loadavg | cut -d'/' -f1)
	TOTAL_TASKS=$(awk '{print $4}' /proc/loadavg | cut -d'/' -f2)
	print_kv "Tasks" "$RUNNING_TASKS running / $TOTAL_TASKS total"
fi

# Scheduler
print_section "Scheduler"

if [ -f /proc/sys/kernel/sched_policy ]; then
	print_kv "Policy" "$(cat /proc/sys/kernel/sched_policy)"
else
	print_kv "Policy" "CFS (Completely Fair Scheduler)"
fi

if [ -f /proc/hutos_sched ]; then
	HUTOS_SCHED_ENABLED=$(grep 'enabled:' /proc/hutos_sched 2>/dev/null | awk '{print $2}')
	if [ "$HUTOS_SCHED_ENABLED" = "yes" ]; then
		print_kv "HUTOS Monitor" "Enabled (use hutsched for details)"
	else
		print_kv "HUTOS Monitor" "Available (disabled)"
	fi
else
	print_kv "HUTOS Monitor" "Not available"
fi

# Processes
print_section "Processes"
if command -v ps >/dev/null 2>&1; then
	PROCESS_COUNT=$(ps -o pid= | wc -l | tr -d ' ')
	print_kv "Running" "$PROCESS_COUNT"
fi

# Init System
print_section "Init System"
if [ -f /proc/1/comm ]; then
	INIT_NAME=$(cat /proc/1/comm)
	print_kv "PID 1" "$INIT_NAME"
else
	print_kv "PID 1" "/init"
fi

# Shell
print_section "Shell"
if [ -n "$SHELL" ]; then
	print_kv "Current Shell" "$SHELL"
elif command -v zsh >/dev/null 2>&1; then
	print_kv "Default Shell" "/bin/zsh"
else
	print_kv "Default Shell" "/bin/sh"
fi

# Filesystem
print_section "Filesystem"
if command -v df >/dev/null 2>&1; then
	ROOTFS_INFO=$(df -h / 2>/dev/null | awk 'NR==2 {print $2" total, "$3" used, "$5" usage"}')
	if [ -n "$ROOTFS_INFO" ]; then
		print_kv "Root" "$ROOTFS_INFO"
	else
		print_kv "Root" "initramfs (in-memory)"
	fi
else
	print_kv "Root" "initramfs (in-memory)"
fi

# Build Information
print_section "Build Information"

if [ -f /etc/hutos-build ]; then
	. /etc/hutos-build
	[ -n "$BUILD_DATE" ] && print_kv "Build Date" "$BUILD_DATE"
	[ -n "$BUILD_HOST" ] && print_kv "Build Host" "$BUILD_HOST"
else
	print_kv "Build Info" "Not available"
fi

print_kv "Userspace" "BusyBox + Zsh"

print_double_separator
echo ""
echo -e "${C_DIM}  For focused information, use: ${C_CYAN}hutctl <command>${C_RESET}"
echo -e "${C_DIM}  Available commands: status, scheduler, memory, cpu, processes${C_RESET}"
echo ""
