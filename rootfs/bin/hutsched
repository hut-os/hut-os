#!/bin/busybox sh
# hutsched — HUTOS Scheduler Monitor and Diagnostic Tool
# Interacts with the HUTOS scheduler latency monitor

# Source common library
. /lib/hutos-common.sh 2>/dev/null || {
	echo "Error: HUTOS common library not found"
	exit 1
}

VERSION="1.0.0"
PROC_HUTOS_SCHED="/proc/hutos_sched"
SYSCTL_PATH="/proc/sys/kernel/hutos_sched_lat"

show_usage() {
	cat <<-EOF
		hutsched — HUTOS Scheduler Monitor
		
		Usage: hutsched [command]
		
		Commands:
		  status, show        Show scheduler statistics (default)
		  on, enable          Enable latency monitoring
		  off, disable        Disable latency monitoring
		  reset, clear        Reset statistics counters
		  stats               Show detailed per-CPU statistics
		  tasks               Show current task information
		  cpu                 Show per-CPU scheduler info
		  latency             Show latency summary
		  help                Show this help message
		  version             Show version information
		
		Description:
		  Monitors and reports HUTOS scheduler wait-latency statistics.
		  Requires CONFIG_HUTOS_SCHED_LAT enabled in kernel.
		  
		  The latency monitor tracks how long runnable tasks wait on
		  the runqueue before getting CPU time.
		
		Examples:
		  hutsched              # Show current statistics
		  hutsched on           # Enable monitoring
		  hutsched stats        # Detailed per-CPU view
		  hutsched reset        # Clear counters
	EOF
}

check_available() {
	if [ ! -f "$PROC_HUTOS_SCHED" ]; then
		die "HUTOS scheduler module not available\nKernel may not have CONFIG_HUTOS_SCHED_LAT enabled"
	fi
}

cmd_status() {
	check_available
	
	print_header "HUTOS Scheduler Status"
	
	cat "$PROC_HUTOS_SCHED"
	
	echo ""
	echo -e "${C_DIM}Tip: Use 'hutsched on' to enable monitoring, 'hutsched stats' for details${C_RESET}"
	echo ""
}

cmd_enable() {
	check_available
	
	if [ -f "$SYSCTL_PATH" ]; then
		echo 1 > "$SYSCTL_PATH" 2>/dev/null || \
			sysctl -w kernel.hutos_sched_lat=1 >/dev/null 2>&1 || \
			die "Failed to enable monitoring (need root privileges)"
		print_status ok "HUTOS scheduler latency monitoring enabled"
	else
		die "Sysctl path not found: $SYSCTL_PATH"
	fi
	
	echo ""
	cmd_status
}

cmd_disable() {
	check_available
	
	if [ -f "$SYSCTL_PATH" ]; then
		echo 0 > "$SYSCTL_PATH" 2>/dev/null || \
			sysctl -w kernel.hutos_sched_lat=0 >/dev/null 2>&1 || \
			die "Failed to disable monitoring (need root privileges)"
		print_status info "HUTOS scheduler latency monitoring disabled"
	else
		die "Sysctl path not found: $SYSCTL_PATH"
	fi
	
	echo ""
}

cmd_reset() {
	check_available
	
	echo reset > "$PROC_HUTOS_SCHED" 2>/dev/null || \
		die "Failed to reset counters (need root/CAP_SYS_ADMIN)"
	
	print_status ok "HUTOS scheduler counters cleared"
	echo ""
	cmd_status
}

cmd_stats() {
	check_available
	
	print_header "HUTOS Scheduler Statistics (Per-CPU)"
	
	# Check if monitoring is enabled
	ENABLED=$(grep 'enabled:' "$PROC_HUTOS_SCHED" 2>/dev/null | awk '{print $2}')
	
	if [ "$ENABLED" != "yes" ]; then
		print_status warn "Monitoring is currently disabled"
		echo ""
		echo -e "${C_DIM}Enable with: ${C_CYAN}hutsched on${C_RESET}"
		echo ""
	fi
	
	# Display full stats
	cat "$PROC_HUTOS_SCHED"
	
	echo ""
}

cmd_tasks() {
	print_header "Current Task Information"
	
	if command -v ps >/dev/null 2>&1; then
		echo ""
		ps -eo pid,state,pri,nice,comm,wchan | head -20
		echo ""
		
		TOTAL=$(ps -o pid= | wc -l | tr -d ' ')
		RUNNING=$(ps -o state= | grep -c R 2>/dev/null || echo 0)
		SLEEPING=$(ps -o state= | grep -c S 2>/dev/null || echo 0)
		
		print_section "Task Summary"
		print_kv "Total Tasks" "$TOTAL"
		print_kv "Running" "$RUNNING"
		print_kv "Sleeping" "$SLEEPING"
	else
		die "ps command not available"
	fi
	
	echo ""
}

cmd_cpu() {
	print_header "Per-CPU Scheduler Information"
	
	CPU_COUNT=$(get_cpu_count)
	print_kv "CPU Cores" "$CPU_COUNT"
	print_kv "Load Average" "$(get_load_average)"
	
	check_available
	
	print_section "HUTOS Scheduler (Per-CPU)"
	grep '^cpu' "$PROC_HUTOS_SCHED" 2>/dev/null || echo "No per-CPU data available"
	
	echo ""
}

cmd_latency() {
	check_available
	
	print_header "HUTOS Scheduler Latency Summary"
	
	# Extract and display latency info
	ENABLED=$(grep 'enabled:' "$PROC_HUTOS_SCHED" 2>/dev/null | awk '{print $2}')
	TOTAL_SAMPLES=$(grep '^total' "$PROC_HUTOS_SCHED" 2>/dev/null | awk '{print $2}')
	
	print_section "Status"
	if [ "$ENABLED" = "yes" ]; then
		print_kv "Monitoring" "Enabled"
	else
		print_kv "Monitoring" "Disabled"
	fi
	
	print_kv "Total Samples" "${TOTAL_SAMPLES:-0}"
	
	print_section "Latency Statistics"
	grep 'min:\|max:\|avg:' "$PROC_HUTOS_SCHED" 2>/dev/null | while read -r line; do
		KEY=$(echo "$line" | awk '{print $1}' | tr -d ':')
		VALUE=$(echo "$line" | awk '{print $2, $3}')
		print_kv "$KEY" "$VALUE"
	done
	
	if [ "$ENABLED" != "yes" ]; then
		echo ""
		print_status info "Enable monitoring with: hutsched on"
	fi
	
	echo ""
}

cmd_version() {
	cat <<-EOF
		hutsched version $VERSION
		HUTOS Scheduler Monitor
		
		Part of HUT Operating System
		Hamedan University of Technology
	EOF
}

# Parse arguments
case "$1" in
	""|status|show)
		cmd_status
		;;
	on|enable)
		cmd_enable
		;;
	off|disable)
		cmd_disable
		;;
	reset|clear)
		cmd_reset
		;;
	stats)
		cmd_stats
		;;
	tasks)
		cmd_tasks
		;;
	cpu)
		cmd_cpu
		;;
	latency|lat)
		cmd_latency
		;;
	version|-v|--version)
		cmd_version
		;;
	help|-h|--help)
		show_usage
		;;
	*)
		echo "Error: Unknown command '$1'"
		echo ""
		show_usage
		exit 1
		;;
esac
